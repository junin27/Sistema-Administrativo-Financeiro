# ============================================
# SISTEMA ADMINISTRATIVO FINANCEIRO
# Configurações de Ambiente
# ============================================

# ==================== OBRIGATÓRIO ====================
# API Key do Google Gemini AI (obrigatório para processamento de PDF)
# Obtenha sua chave em: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=sua_chave_aqui

# ==================== BANCO DE DADOS ====================
# PostgreSQL (Produção - Recomendado)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sistema_financeiro

# SQLite (Desenvolvimento - Opcional)
# DATABASE_URL=sqlite:///./sistema_financeiro.db

# Configurações PostgreSQL (se usar Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sistema_financeiro
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ==================== FRONTEND ====================
# URL da API para o Frontend
VITE_API_URL=http://localhost:8000/api/v1

# ==================== CONFIGURAÇÕES GERAIS ====================
# Modo de Debug (true/false)
DEBUG=true

# Nível de Log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Nome da Aplicação
APP_NAME=Sistema Administrativo Financeiro

# Versão
APP_VERSION=1.0.0

# Ambiente
VITE_ENV=development
