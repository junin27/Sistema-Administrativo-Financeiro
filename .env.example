# Configurações do Banco de Dados
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/sistema_financeiro

# Configurações da API Google Gemini
GOOGLE_API_KEY=your_google_api_key_here

# Configurações da Aplicação
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=Sistema Administrativo Financeiro
APP_VERSION=1.0.0

# Configurações do Frontend
VITE_API_URL=http://localhost:8000/api/v1
VITE_ENV=development

# Configurações do PostgreSQL
POSTGRES_DB=sistema_financeiro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# Configurações do PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@sistema.com
PGADMIN_DEFAULT_PASSWORD=admin123